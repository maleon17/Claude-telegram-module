[Unit]
Description=Codex Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/.claude-telegram-bridge
Environment=PATH=/home/YOUR_USER/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
Environment=OWNER_ID=YOUR_TELEGRAM_USER_ID
Environment=CODEX_CWD=/home/YOUR_USER
Environment=CODEX_SANDBOX=danger-full-access
Environment=CODEX_BOT_STATE_FILE=/home/YOUR_USER/.claude-telegram-bridge/codex-telegram-bot/state.json
ExecStart=/usr/bin/python3 /home/YOUR_USER/.claude-telegram-bridge/codex-telegram-bot/bot.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
